program ::= { statement } finish

finish ::= "finish" operand ";"

statement ::= var_decl | assignment | if | while

var_decl ::= ( "🍃" | "🪨" ) ident ":" type "<-" expr ";"

assignment ::= ident "<-" expr ";"

if ::= "🐤" expr block [ "🦢" block ]

while ::= "waddle" expr block

block      ::= "🪶" block_item { block_item } "🪽"
block_item ::= statement | finish

type ::= "🐥" | "🦆" | "🥚"

operand ::= ident | number | "🪺" | "🪹" | "(" expr ")"

expr ::= arith [ ( "≡" | "≢" ) arith ]

arith ::= term { ("+" | "-") term }

term ::= operand { ( "*" | "/" ) operand }

ident      ::= ( letter | "_" ) { letter | digit | "_" }
letter     ::= "a" | ... | "z" | "A" | ... | "Z"
digit      ::= "0" | ... | "9"
number     ::= digit { digit }