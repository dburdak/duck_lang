program ::= { top_item } finish

top_item ::= func_decl | struct_decl | statement

func_decl ::= "hatch" ident "(" [ params ] ")" "->" type block

params ::= param { "," param }

param ::= ident ":" type

struct_decl ::= "flock" ident "🪶" { member } "🪽"

member ::= field_decl | member_func_decl

field_decl ::= ( "🍃" | "🪨" ) ident ":" type ";"

member_func_decl ::= ( "🍃" | "🪨" ) "hatch" ident "(" [ params ] ")" "->" type block

statement ::= var_decl | simple_stmt | if | while | print | return_stmt

var_decl ::= specifier ident ":" type "<-" expr ";"

specifier ::= "🍃" | "leaf" | "hatch" | "🪨" | "stone" | "rock"

simple_stmt ::= assignable [ "<-" expr | swap_tail ] ";" | postfix ";"

swap_tail ::= swap_op assignable { swap_op assignable }

assignable ::= ident { "." ident }

swap_op ::= "🔀" | "swap"

print ::= "🔊" ( string | expr ) ";"

string ::= "\"" { ? any character except quotation mark and line break ? } "\""

return_stmt ::= "lay" expr ";"

if ::= ( "🐤" | "peck" ) expr block [ ( "🦢" | "swan" ) block ]

while ::= ( "🔁" | "waddle" ) expr block

block ::= ( "🪶" | "feather" ) block_item { block_item } ( "🪽" | "wing" )

block_item ::= statement | finish

finish ::= ( "finish" | "fly" | "🏁" ) operand ";"

type ::= "🐥" | "duck32" | "🦆" | "duck64" | "🥚" | "pond_bool" | ident

bool_literal ::= "🪺" | "nest_full" | "🪹" | "nest_empty"

operand ::= ident | number | bool_literal | "(" expr ")"

expr ::= arith [ cmp_op arith ]

arith ::= term { ("+" | "-") term }

term ::= postfix { ( "*" | "/" ) postfix }

postfix ::= primary { "." ident | "(" [ arguments ] ")" }

primary ::= ident | number | bool_literal | "(" expr ")" | object_creation | read_expr

arguments ::= expr { "," expr }

object_creation ::= ident "{" ident ":" expr { "," ident ":" expr } "}"

read_expr ::= "👂" type

cmp_op ::= "≡" | "eq" | "≢" | "neq"

ident      ::= ( letter | "_" ) { letter | digit | "_" }
letter     ::= "a" | ... | "z" | "A" | ... | "Z"
digit      ::= "0" | ... | "9"
number     ::= digit { digit }
