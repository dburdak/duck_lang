Program
  Struct Counter
    Field value 🐥 mut index=0
    MemberFunction increment -> 🐥 mut assigns_field=True
      Block
        Assign value
          BinOp +
            Var value
            Const 1
        Return
          Var value
    MemberFunction update_local -> 🐥 const assigns_field=False
      Block
        Decl local Counter mut
          ObjectCreate Counter
            Initializer value
              Const 1
        Assign Field
          FieldAccess value
