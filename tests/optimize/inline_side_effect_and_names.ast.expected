Program
  Decl result 🐥 mut
    Const 10
  Decl answer 🐥 mut
    InlineExpr
      Decl __inline_show_and_add_1_value 🐥 const
        Var result
      Decl __inline_show_and_add_2_result 🐥 mut
        BinOp +
          Var __inline_show_and_add_1_value
          Const 2
      Print
        Var __inline_show_and_add_2_result
    InlineValue
      BinOp +
